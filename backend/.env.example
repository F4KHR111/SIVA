# PostgreSQL Connection String (Vercel Postgres, Neon, Supabase, etc.)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://username:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Direct URL (digunakan untuk migrasi / pooling seperti PgBouncer di Supabase / Neon / Vercel)
# Jika tidak memakai pooler, samakan dengan DATABASE_URL
DIRECT_URL="postgresql://username:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"
